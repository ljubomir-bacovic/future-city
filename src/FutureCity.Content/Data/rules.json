{
  // Global rules for setting up a game. Map sizes are in tiles and are tunable.
  "mapSizes": [
    { "id": "small",  "name": "Small",  "width": 64,  "height": 64 },
    { "id": "medium", "name": "Medium", "width": 96,  "height": 96 },
    { "id": "large",  "name": "Large",  "width": 128, "height": 128 }
  ],
  "defaultMapSize": "small",
  "defaultTerrain": "grass",

  // Seeded terrain generation: lakes and forests from smooth noise, then a cleared start area for the band.
  "mapGeneration": {
    "waterTerrain": "water",
    "forestTerrain": "forest",
    "waterPercent": 12,
    "forestPercent": 22,
    "featureSize": 16,      // size of lakes and woods in tiles (noise cell size)
    "startClearRadius": 4   // open grassland around the starting camp
  }
}
