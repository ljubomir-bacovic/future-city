{
  // Wild food sources. Plants regrow; animals breed toward the local carrying capacity,
  // so a herd hunted faster than it breeds dies out (overhunting).
  "plants": [
    {
      "id": "berry_bush", "name": "Berry bush", "color": "#a8324a", "good": "berries",
      "maxFood": 120,
      "ticksPerFood": 4,            // gathering speed
      "regrowIntervalTicks": 25,    // +regrowAmount every interval while the bush still has berries (seasons scale it)
      "regrowAmount": 1,
      "dormantTicks": 900,          // a stripped bush needs 90 s before it fruits again
      "clustersPer10kTiles": 25,
      "minClusterSize": 3, "maxClusterSize": 6,
      "startClusters": 2            // guaranteed clusters near the starting camp
    }
  ],
  "animals": [
    {
      "id": "deer", "name": "Deer", "color": "#8a5a32", "good": "meat",
      "food": 100,                  // meat from one carcass
      "killTicks": 30,              // time to bring one down once in reach
      "butcherTicksPerFood": 2,
      "carcassDecayIntervalTicks": 12, // a carcass loses 1 food this often (spoilage)
      "moveTicksPerTile": 4,
      "wanderRadius": 6,
      "wanderChancePerTick": 2,     // in percent, while standing still
      "breedIntervalTicks": 300,
      "breedChancePercent": 30,
      "localCapacity": 8,           // no births once this many of the kind have homes within capacityRadius
      "capacityRadius": 8,
      "herdsPer10kTiles": 10,
      "minHerdSize": 3, "maxHerdSize": 6,
      "startHerds": 1               // guaranteed herds within reach of the starting camp
    }
  ],
  // Finite raw materials. Clay is found next to water; silver is rare.
  "deposits": [
    {
      "id": "stone_outcrop", "name": "Stone outcrop", "color": "#9a9a92", "good": "stone",
      "amount": 150, "ticksPerUnit": 6, "work": "quarry",
      "clustersPer10kTiles": 8, "minClusterSize": 1, "maxClusterSize": 3, "startClusters": 1, "nearWater": false
    },
    {
      "id": "clay_pit", "name": "Clay pit", "color": "#b5683f", "good": "clay",
      "amount": 120, "ticksPerUnit": 5, "work": "dig",
      "clustersPer10kTiles": 8, "minClusterSize": 1, "maxClusterSize": 2, "startClusters": 1, "nearWater": true
    },
    {
      "id": "silver_vein", "name": "Silver vein", "color": "#c8cdd2", "good": "silver",
      "amount": 80, "ticksPerUnit": 15, "work": "quarry",
      "clustersPer10kTiles": 3, "minClusterSize": 1, "maxClusterSize": 1, "startClusters": 1, "nearWater": false
    }
  ]
}
