{
  // Citizens: ageing, needs and the band's starting conditions.
  // The length of a year is set by the calendar in rules.json.
  "adultAgeYears": 12,          // working age: children eat but cannot be given orders (forager and farming
                                // children did real work from about this age)
  "oldAgeYears": 50,            // from this age the yearly chance of a natural death rises...
  "oldAgeDeathPercentPerYear": 4, // ...by this many percentage points per year past oldAgeYears

  "maxHealth": 1000,
  "healthRegenPerTick": 2,      // while not starving
  "maxHunger": 1000,            // at this hunger a citizen is starving and loses health
  "hungerPerTick": 1,
  "eatAtHunger": 400,           // citizens eat from the shared store when this hungry
  "foodPerMeal": 10,
  "hungerPerMeal": 400,
  "starvationDamagePerTick": 4, // about 25 s from starving to death

  "moveTicksPerTile": 3,        // on open grassland; terrain moveCost and diagonals add to it
  "carryCapacity": 10,          // goods carried per trip

  "start": { "citizens": 8, "goods": { "berries": 120 }, "minAgeYears": 8, "maxAgeYears": 35 },
  "camp": { "shelter": 10 },    // people the camp's lean-tos and fire can shelter; huts add more

  // A child is born when the band has a food surplus and shelter to spare.
  "growth": {
    "checkIntervalTicks": 100,
    "foodPerCapita": 15,        // store must hold this many meals per person (plus the birth cost)
    "birthFoodCost": 40,
    "birthChancePercent": 35,
    "populationCap": 100
  },

  // Automatic job assignment (once an institution with autoJobs is established).
  "jobs": {
    "checkIntervalTicks": 20,
    "foodTargetPerCapita": 25,  // meals in store per person the band aims for
    "buildPriority": 60,        // demand score of helping at a construction site
    "researchPriority": 30,     // demand score of working at a shrine while something can be discovered
    "maxBuildersPerSite": 3,
    "gatherRadius": 30          // how far from camp (in tiles) automatic gatherers look for sources
  }
}
