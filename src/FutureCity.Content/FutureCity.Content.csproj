<Project Sdk="Microsoft.NET.Sdk">

  <!-- Game data. JSON files under Data/ are embedded so they ship inside the assembly (including Godot exports). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>FutureCity.Content</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\**\*.json" LogicalName="content/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
